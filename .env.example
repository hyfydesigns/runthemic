# --- Required for the app to boot ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/runthemic"
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"
# AES-256-GCM key for encrypting stored YouTube refresh tokens. generate with: openssl rand -base64 32
ENCRYPTION_KEY="generate-with: openssl rand -base64 32"

# --- Optional: Google login + YouTube integration ---
# Create an OAuth client at https://console.cloud.google.com/apis/credentials
# Login uses basic profile/email scopes only; YouTube playlist access is requested
# separately from Settings > YouTube, never during sign-in.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Optional: Apple login ---
APPLE_CLIENT_ID=""
APPLE_TEAM_ID=""
APPLE_KEY_ID=""
APPLE_PRIVATE_KEY=""

# --- Optional: Stripe (scaffold only, no live checkout in MVP) ---
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# --- Optional: transactional email (RSVP reminders, notifications) ---
EMAIL_FROM=""
RESEND_API_KEY=""

# Port the custom server (Next + Socket.IO) listens on
PORT=3000
