# --- Required for the app to boot ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/runthemic"
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"
# AES-256-GCM key for encrypting stored YouTube refresh tokens. generate with: openssl rand -base64 32
ENCRYPTION_KEY="generate-with: openssl rand -base64 32"

# --- Optional: Google login + YouTube integration ---
# Create an OAuth client at https://console.cloud.google.com/apis/credentials
# Login uses basic profile/email scopes only; YouTube playlist access is requested
# separately from Settings > YouTube, never during sign-in.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Optional: Apple login ---
APPLE_CLIENT_ID=""
APPLE_TEAM_ID=""
APPLE_KEY_ID=""
APPLE_PRIVATE_KEY=""

# --- Optional: Stripe (scaffold only, no live checkout in MVP) ---
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# --- Optional: transactional email (signup verification, RSVP reminders, notifications) ---
# Get a key at https://resend.com. Until both of these are set, new accounts
# are auto-verified and login isn't gated on email verification at all.
EMAIL_FROM=""
RESEND_API_KEY=""

# --- Optional: Cloudflare Turnstile spam filter on registration + RSVP forms ---
# Add a site at https://dash.cloudflare.com/?to=/:account/turnstile. Until both
# are set, forms submit with no bot-check at all.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Port the custom server (Next + Socket.IO) listens on
PORT=3000
